# Copy this file to .env for local development:
#   cp .env.example .env
#
# Leave both blank (or skip .env entirely) to run in in-memory mode --
# fine for local testing, but room/role data resets every time the
# server restarts.
#
# For a real deploy, create a free database at https://upstash.com
# (Redis -> Create Database -> REST API section) and paste the two
# values below. On Render, set these as environment variables in the
# service settings instead of uploading a .env file.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only needed locally if you want a port other than 3000.
# Render sets PORT automatically -- don't set it yourself on Render.
PORT=3000
